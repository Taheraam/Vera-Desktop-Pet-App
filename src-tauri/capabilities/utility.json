{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "utility",
  "description": "The tasks / notes / clock / settings window. Agent delegation and MCP connection commands are not granted to any window until they are wired to a real UI.",
  "windows": ["utility"],
  "permissions": [
    "allow-create-task",
    "allow-update-task",
    "allow-complete-task",
    "allow-reopen-task",
    "allow-delete-task",
    "allow-list-tasks",
    "allow-save-note",
    "allow-delete-note",
    "allow-list-notes",
    "allow-create-alarm",
    "allow-delete-alarm",
    "allow-list-alarms",
    "allow-get-missed-alarms-summary",
    "allow-acknowledge-alarm",
    "allow-set-auto-start",
    "allow-get-xp-state",
    "allow-add-provider-key",
    "allow-remove-provider-key",
    "allow-verify-provider-key",
    "allow-list-providers",
    "allow-set-active-provider",
    "allow-respond-to-consent-request",
    "allow-list-agent-actions",
    "allow-get-permission-status",
    "allow-set-context-engine",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
